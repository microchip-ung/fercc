#
# Used by the 'dr' script (sw-tool-docker-run) to run commands inside the
# fercc build container.  Examples:
#
#   dr cargo build --release
#   dr cargo test
#   dr syft . -o spdx-json=fercc-sbom.spdx.json
#   dr grype sbom:fercc-sbom.spdx.json
#   dr -d cargo build       # debug mode: use :latest, skip digest check
#
# After the first CI build of sw-fercc-docker, fill in MCHP_DOCKER_TAG and
# MCHP_DOCKER_DIGEST from the published image and uncomment the digest line.

MCHP_DOCKER_NAME=artifacts-aws.devops.microchip.com:7996/ung/sw-fercc-docker/build-env
MCHP_DOCKER_TAG=main.7-a99e577d9944
MCHP_DOCKER_DIGEST=sha256:1ae378ca3fe31986a741a018ad33c08a7a76e3f099f92b76a232b67a26bd5986

# Pass caller identity into the container so artefacts are owned by the right
# user.  CARGO_HOME is redirected to the mounted home so the crate registry
# cache persists across dr invocations.
MCHP_DOCKER_OPTIONS="-e BLD_USER=$(id -un) \
    -e BLD_UID=$(id -u) \
    -e BLD_GECOS=$(getent passwd $(id -un) | cut -d: -f5 | cut -d, -f1) \
    -e CARGO_HOME=/mapped_home/.cargo \
    -v $HOME:/mapped_home"
